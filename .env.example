# Find A Place Booking — environment variable template
# Never commit real secrets. Copy this file to .env.local for local development.

# Application
NEXT_PUBLIC_APP_ENV=development
BOOKING_CHECKOUT_ENABLED=false
# Generate at least 32 random characters. Rotating this invalidates guest trip links.
BOOKING_GUEST_TOKEN_SECRET=

# Application URL used for auth redirects. Keep local during development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Reserved for privileged server-only workflows. Do not expose these to the browser.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend / transactional email
RESEND_API_KEY=
EMAIL_DOMAIN=hometownwebservicesar.cc
EMAIL_FROM_BOOKINGS=bookings
EMAIL_FROM_SUPPORT=support
EMAIL_FROM_SYSTEM=noreply
EMAIL_PLATFORM_NAME=Find A Place Booking
EMAIL_INTERNAL_ALERT_TO=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=

# Automatic calendar, payout and notification synchronization.
CRON_SECRET=
CALENDAR_SYNC_INTERVAL_MINUTES=15

# Stripe platform. Keep both key types in the same mode. LIVE remains blocked
# by the database property allowlist and verified tax snapshot requirement.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Platform-account webhook signing secret.
STRIPE_WEBHOOK_SECRET=
# Optional second endpoint secret when Stripe sends connected-account events
# (payout.created/updated/paid/failed) to this same webhook route.
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_PROCESSING_RATE_BPS=
STRIPE_PROCESSING_FIXED_CENTS=

# Stripe Identity. TEST verifications are stored as $0 internal cost. LIVE uses
# this accounting estimate; update if Stripe pricing changes.
STRIPE_IDENTITY_COST_CENTS=150

# Find A Place calculates and remits marketplace lodging taxes from its own
# verified/effective-dated tax rules. Stripe Tax is not used for booking tax math.

# Square platform/developer application — reserved for seller OAuth + Payments API.
# Seller OAuth tokens are NOT environment variables and must never be committed.
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_PLATFORM_LOCATION_ID=

# Mapbox. NEXT_PUBLIC_MAPBOX_TOKEN is the browser-safe public token used to
# render maps. MAPBOX_GEOCODING_TOKEN is server-only and may initially be the
# same token; permanent geocoding must be enabled on the Mapbox account because
# property coordinates are stored in Supabase.
NEXT_PUBLIC_MAPBOX_TOKEN=
MAPBOX_GEOCODING_TOKEN=

# Monitoring variables will be added when that milestone begins.
# Live payment credentials must not be used during local development.
