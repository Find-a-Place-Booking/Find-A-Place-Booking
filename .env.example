# Find A Place Booking — environment variable template
# Never commit real secrets. Copy this file to .env.local for local development.

# Application
NEXT_PUBLIC_APP_ENV=development

# Supabase
# New Supabase projects prefer the publishable key. The application currently
# accepts the legacy anon key as a fallback so either dashboard format works.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Reserved for later privileged server-only workflows. Not required in Milestone 3.
# Prefer Supabase's current secret-key model when available; keep service-role
# support only where a later server workflow genuinely requires it.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend / transactional email (wired in a later verified milestone)
# Keep sender identity environment-driven so the development domain can be
# replaced by the final Find A Place Booking domain without changing routes.
RESEND_API_KEY=
EMAIL_DOMAIN=hometownwebservicesar.cc
EMAIL_FROM_BOOKINGS=bookings
EMAIL_FROM_SUPPORT=support
EMAIL_FROM_SYSTEM=noreply
EMAIL_PLATFORM_NAME=Find A Place Booking
EMAIL_INTERNAL_ALERT_TO=

# Cloudflare Turnstile (wired later)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Stripe / Square / tax / monitoring / mapping variables will be added only when
# those milestones begin. Live payment credentials must not be used during development.
